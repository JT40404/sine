# Optional but strongly recommended: a free CoinGecko Demo API key (coingecko.com/en/api).
# Without a key, the API uses GeckoTerminal's keyless tier, which is rate-limited per IP —
# and Vercel functions share IPs with other projects, so you'll see "rate-limited" errors.
COINGECKO_API_KEY=

# "demo" (free key) or "pro" (paid key). Ignored when no key is set.
COINGECKO_PLAN=demo

# ── Launchpad ───────────────────────────────────────────────────────────────
# Pinata JWT (free account at pinata.cloud) — stores coin images + metadata on IPFS for pump.fun launches.
PINATA_JWT=
# Solana RPC for the launchpad (use a paid provider such as Helius or QuickNode; the URL may contain its key — it stays server-side).
RPC_URL=https://api.mainnet-beta.solana.com

# ── SINE Forge (optional platform revenue) ──────────────────────────────────
# Leave FORGE_PARTNER_WALLET empty to run Forge with no platform fee: creators then receive all non-Meteora fees.
FORGE_PARTNER_WALLET=
# % of the creator/platform side of trading fees that the platform keeps (0-100, default 20).
FORGE_PLATFORM_FEE_SHARE=20
# Optional flat launch fee in SOL (0, or 0.001-100).
FORGE_POOL_CREATION_FEE_SOL=0
# Program id of your deployed programs/sine-hooks transfer hook (turns on "On-chain rules" in /forge).
FORGE_HOOK_PROGRAM=
